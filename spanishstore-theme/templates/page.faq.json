        "q_1_4": {
          "type": "question",
          "settings": {
            "question": "Do you offer gifts and corporate orders?",
            "answer": "<p>Yes. We prepare gift sets and corporate orders for teams and clients. Contact us and tell us the number of gifts and your budget.</p>",
            "open": false
