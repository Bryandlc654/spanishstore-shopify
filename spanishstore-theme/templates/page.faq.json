          "settings": {
            "question": "How do pack discounts work?",
            "answer": "<p>Build a pack of 3, 5, 8 or 10 products in <strong>Build your pack</strong> and save 5%, 10%, 15% or 20% on the whole pack. You can see the saving in the pack summary before adding it to the cart.</p>",
            "open": false
          }
