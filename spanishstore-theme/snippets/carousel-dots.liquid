{% doc %}
  Puntos de un carrusel horizontal (solo móvil). Se colocan dentro de <carousel-slider>, después de la pista;
  el JavaScript del carrusel (snippets/carousel-arrows.liquid) marca el activo al deslizar y permite tocarlos.

  @param {number} count - Número de tarjetas (un punto por tarjeta)

  @example
  {% render 'carousel-dots', count: section.blocks.size %}
{% enddoc %}

{%- if count > 1 -%}
  <div class="carousel__dots" data-carousel-dots>
    {%- for i in (1..count) -%}
      <button
        type="button"
        class="carousel__dot"
        aria-label="{{ 'sections.features.go_to' | t: number: forloop.index, count: count }}"
        {% if forloop.first %}
          aria-current="true"
        {% endif %}
        data-index="{{ forloop.index0 }}"
      ></button>
    {%- endfor -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: 0.375rem;
    margin-block-start: 1.75rem;
  }

  .carousel__dot {
    position: relative;
    width: 0.5625rem;
    height: 0.5625rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: #e9e8e5;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  /* Zona táctil más grande que el punto */
  .carousel__dot::before {
    content: '';
    position: absolute;
    inset: -0.5rem -0.1875rem;
  }

  .carousel__dot[aria-current='true'] {
    background-color: var(--color-accent);
  }

  @media (min-width: 750px) {
    .carousel__dots {
      display: none;
    }
  }
{% endstylesheet %}
