{% doc %}
  Tarjeta de categoría (colección): imagen de fondo, capa oscura y nombre centrado.
  - La colección da el enlace y, si no se pasan, el nombre y la imagen.
  - Sin imagen ni colección usa assets/category-<nombre>.jpg si existe para ese nombre
    (charcuterie, seafood, cheese, paella, snacks-desserts, gift-sets) o un placeholder.
  Variables CSS opcionales en un contenedor: --category-overlay (0–1) y --category-fg (color del texto).

  @param {collection} [collection] - Colección enlazada
  @param {string} [title] - Título (sobrescribe el de la colección)
  @param {image} [image] - Imagen (sobrescribe la de la colección)
  @param {number} [index] - Índice para alternar placeholders
  @param {string} [sizes] - Atributo sizes de la imagen

  @example
  {% render 'category-card', collection: block.settings.collection, title: block.settings.title, image: block.settings.image %}
{% enddoc %}

{%- liquid
  assign fallback_images = 'charcuterie,seafood,cheese,paella,snacks-desserts,gift-sets' | split: ','
  assign title = title | default: collection.title
  assign image = image | default: collection.featured_image
  assign sizes = sizes | default: '(min-width: 990px) 170px, (min-width: 750px) 25vw, 45vw'

  if collection != blank
    assign url = collection.url
  else
    assign url = routes.collections_url
  endif

  assign title_handle = title | handleize
-%}

<a href="{{ url }}" class="category-card">
  {%- if image != blank -%}
    {{
      image
      | image_url: width: 900
      | image_tag: class: 'category-card__image', alt: '', loading: 'lazy', widths: '300, 450, 600, 900', sizes: sizes
    }}
  {%- elsif fallback_images contains title_handle -%}
    {%- assign category_url = 'category-' | append: title_handle | append: '.jpg' | asset_url -%}
    <img
      class="category-card__image"
      src="{{ category_url }}"
      srcset="{%- render 'asset-srcset', url: category_url, max: 640 -%}"
      sizes="{{ sizes }}"
      alt=""
      width="640"
      height="360"
      loading="lazy"
    >
  {%- else -%}
    {%- assign placeholder = index | default: 1 | modulo: 6 | plus: 1 | prepend: 'collection-' -%}
    {{ placeholder | placeholder_svg_tag: 'category-card__image category-card__image--placeholder' }}
  {%- endif -%}
  <span class="category-card__title">{{ title | default: 'Category' | escape }}</span>
</a>

{% stylesheet %}
  .category-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    background-color: #2b2b2b;
    color: var(--category-fg, #fff9e4);
    text-decoration: none;
    isolation: isolate;
  }

  .category-card__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .category-card__image--placeholder {
    fill: #666;
    background-color: #444;
  }

  /* Capa oscura para que el texto se lea */
  .category-card::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: '';
    background-color: rgb(0 0 0 / var(--category-overlay, 0.4));
    transition: background-color 0.3s ease;
  }

  .category-card:hover .category-card__image {
    transform: scale(1.06);
  }

  .category-card:hover::after {
    background-color: rgb(0 0 0 / calc(var(--category-overlay, 0.4) * 0.7));
  }

  .category-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .category-card__title {
    padding: 0.5rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card__image {
      transition: none;
    }

    .category-card:hover .category-card__image {
      transform: none;
    }
  }
{% endstylesheet %}
