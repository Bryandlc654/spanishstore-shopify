{% doc %}
  Tarjeta de artículo del blog (recetas, productores, cultura…): imagen, categoría | fecha,
  título, extracto y botón "Read More" pegado abajo.
  La usan la sección "Recipes" de la home (blog-posts), el listado del blog (main-blog) y
  "More from the blog" en el artículo (main-article).
  Sin imagen usa las fotos por defecto assets/recipe-default-1…4.jpg (según index).
  Sin artículo (tarjetas de ejemplo) muestra textos de muestra.

  @param {article} [article] - Artículo
  @param {number} [index] - Posición (para alternar las fotos por defecto)
  @param {string} [category] - Texto de la categoría (por defecto, la primera etiqueta)
  @param {boolean} [show_category] - Mostrar la categoría (por defecto true)
  @param {boolean} [show_date] - Mostrar la fecha (por defecto true)
  @param {string} [read_more_label] - Texto del botón (vacío = sin botón)
  @param {string} [heading_tag] - Etiqueta del título: 'h2' o 'h3' (por defecto)
  @param {string} [sizes] - Atributo sizes de la imagen

  @example
  {% render 'article-card', article: article, index: forloop.index0, read_more_label: 'Read More' %}
{% enddoc %}

{%- liquid
  assign index = index | default: 0
  assign default_image = index | modulo: 4 | plus: 1
  assign heading_tag = heading_tag | default: 'h3'
  assign sizes = sizes | default: '(min-width: 990px) 280px, (min-width: 750px) 45vw, 90vw'
  if show_category == false
    assign show_category = false
  else
    assign show_category = true
  endif
  if show_date == false
    assign show_date = false
  else
    assign show_date = true
  endif
  if article != blank and category == blank
    assign category = article.tags.first
  endif
  if category == blank
    assign show_category = false
  endif
  assign has_meta = false
  if show_category or show_date
    assign has_meta = true
  endif
-%}
{%- assign default_recipe_url = 'recipe-default-' | append: default_image | append: '.jpg' | asset_url -%}

<article class="recipe-card">
  {%- if article != blank -%}
    <a href="{{ article.url }}" class="recipe-card__media" tabindex="-1" aria-hidden="true">
      {%- if article.image != blank -%}
        {{
          article.image
          | image_url: width: 900
          | image_tag: class: 'recipe-card__image', alt: '', loading: 'lazy', widths: '300, 450, 600, 900', sizes: sizes
        }}
      {%- else -%}
        <img
          class="recipe-card__image"
          src="{{ default_recipe_url }}"
        srcset="{%- render 'asset-srcset', url: default_recipe_url, max: 674 -%}"
        sizes="{{ sizes }}"
          alt=""
          width="736"
          height="478"
          loading="lazy"
        >
      {%- endif -%}
    </a>
  {%- else -%}
    <div class="recipe-card__media">
      <img
        class="recipe-card__image"
        src="{{ default_recipe_url }}"
        srcset="{%- render 'asset-srcset', url: default_recipe_url, max: 674 -%}"
        sizes="{{ sizes }}"
        alt=""
        width="736"
        height="478"
        loading="lazy"
      >
    </div>
  {%- endif -%}

  <div class="recipe-card__body">
    {%- if article != blank -%}
      {%- if has_meta -%}
        <p class="recipe-card__meta">
          {%- if show_category -%}
            <span>{{ category | escape }}</span>
            {%- if show_date %} | {% endif -%}
          {%- endif -%}
          {%- if show_date -%}
            {{ article.published_at | time_tag: '%B %-d, %Y' }}
          {%- endif -%}
        </p>
      {%- endif -%}

      <{{ heading_tag }} class="recipe-card__title">
        <a href="{{ article.url }}">{{ article.title | escape }}</a>
      </{{ heading_tag }}>

      {%- assign excerpt = article.excerpt_or_content | strip_html | truncatewords: 22 -%}
      {%- if excerpt != blank -%}
        <p class="recipe-card__excerpt">{{ excerpt }}</p>
      {%- endif -%}

      {%- if read_more_label != blank -%}
        <a href="{{ article.url }}" class="button button--primary recipe-card__button">
          {{- read_more_label | escape -}}
          <span class="visually-hidden">: {{ article.title | escape }}</span>
        </a>
      {%- endif -%}
    {%- else -%}
      <p class="recipe-card__meta">Category | September 30, 2026</p>
      <{{ heading_tag }} class="recipe-card__title">Lorem ipsum dolor sit amet consectetur. Tortor aliquam amet.</{{ heading_tag }}>
      <p class="recipe-card__excerpt">
        Lorem ipsum dolor sit amet consectetur. Ullamcorper in id vitae enim sapien tellus. Condimentum.
      </p>
      {%- if read_more_label != blank -%}
        <span class="button button--primary recipe-card__button">{{ read_more_label | escape }}</span>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .recipe-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid #f4f0e2;
    border-radius: 5px;
    background-color: #fff;
  }

  .recipe-card__media {
    display: block;
    aspect-ratio: 277 / 180;
    overflow: hidden;
    background-color: #f2f2f2;
  }

  .recipe-card__image {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .recipe-card:hover .recipe-card__image {
    transform: scale(1.04);
  }

  .recipe-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.875rem 1.1875rem 1rem;
  }

  .recipe-card__meta {
    margin: 0;
    color: #646b7c;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .recipe-card__title {
    display: -webkit-box;
    margin: 1.125rem 0 0;
    overflow: hidden;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.24;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .recipe-card__title a {
    color: #000;
    text-decoration: none;
  }

  .recipe-card__title a:hover {
    text-decoration: underline;
  }

  .recipe-card__excerpt {
    display: -webkit-box;
    margin: 0.4375rem 0 0;
    overflow: hidden;
    color: #646b7c;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.24;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .recipe-card__button {
    min-height: 1.8125rem;
    margin-block-start: auto;
    padding: 0.25rem 1.4375rem;
    border-radius: 3px;
    text-transform: none;
    letter-spacing: 0;
  }

  /* El botón se pega abajo (botones alineados aunque los textos midan distinto)
     y el elemento anterior deja al menos 10 px de hueco */
  .recipe-card__body > :nth-last-child(2) {
    margin-block-end: 0.625rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .recipe-card__image {
      transition: none;
    }

    .recipe-card:hover .recipe-card__image {
      transform: none;
    }
  }
{% endstylesheet %}
