{% comment %}
  Página 404 (dirección que no existe).
  - "404" grande en rojo, título, texto y buscador de productos (envía a /search).
  - Botones a la portada y a la tienda.
  Debajo, en la plantilla, van las categorías principales (category-cards) y los productos
  destacados (product-carousel), para que el cliente siga comprando.
{% endcomment %}

<div class="main-404 full-width">
  <p class="main-404__code" aria-hidden="true">404</p>
  <h1 class="main-404__title">
    {%- if section.settings.heading != blank -%}
      {{- section.settings.heading | escape -}}
    {%- else -%}
      {{- '404.title' | t -}}
    {%- endif -%}
  </h1>
  {%- if section.settings.text != blank -%}
    <div class="main-404__text">{{ section.settings.text }}</div>
  {%- endif -%}

  <form action="{{ routes.search_url }}" method="get" role="search" class="main-404__search">
    <input type="hidden" name="type" value="product">
    <label for="Search404" class="visually-hidden">{{ 'search.submit' | t }}</label>
    <input
      type="search"
      id="Search404"
      name="q"
      class="main-404__search-input"
      placeholder="{{ section.settings.search_placeholder | escape }}"
      autocomplete="off"
    >
    <button type="submit" class="main-404__search-button" aria-label="{{ 'search.submit' | t }}">
      {{- 'icon-search.svg' | inline_asset_content -}}
    </button>
  </form>

  <div class="main-404__actions">
    <a href="{{ routes.root_url }}" class="button button--secondary">{{ '404.home' | t }}</a>
    <a href="{{ routes.all_products_collection_url }}" class="button button--primary">{{ '404.back_to_shopping' | t }}</a>
  </div>
</div>

{% stylesheet %}
  .main-404 {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(40rem, 100% - var(--page-margin) * 2);
    margin-inline: auto;
    padding-block: 3rem 2rem;
    text-align: center;
  }

  .main-404__code {
    margin: 0;
    color: var(--color-accent);
    font-size: 5.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .main-404__title {
    margin: 0.75rem 0 0;
    color: #000;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .main-404__text {
    margin-block-start: 0.75rem;
    color: #313131;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .main-404__text p {
    margin: 0;
  }

  .main-404__search {
    display: flex;
    width: 100%;
    max-width: 30rem;
    margin-block-start: 1.75rem;
    overflow: hidden;
    border: 1px solid #dbdbdc;
    border-radius: 4px;
    background-color: #f2f2f3;
  }

  .main-404__search:focus-within {
    border-color: #646b7c;
  }

  .main-404__search-input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 0;
    background: none;
    font-size: 0.9375rem;
  }

  .main-404__search-input:focus-visible {
    outline-offset: -2px;
  }

  .main-404__search-button {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    border: 0;
    background-color: var(--color-accent);
    color: #fff;
    cursor: pointer;
  }

  .main-404__search-button svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .main-404__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 1.5rem;
  }

  .main-404__actions .button--secondary {
    color: #000;
  }

  @media (min-width: 750px) {
    .main-404 {
      padding-block: 4.5rem 2.5rem;
    }

    .main-404__code {
      font-size: 8rem;
    }

    .main-404__title {
      font-size: 1.4375rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "tag": "section",
  "class": "main-404-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Page not found"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>The page you're looking for doesn't exist or has moved. Try searching for a product or explore our categories.</p>"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "t:labels.search_placeholder",
      "default": "Search products, brands and flavors..."
    }
  ]
}
{% endschema %}
