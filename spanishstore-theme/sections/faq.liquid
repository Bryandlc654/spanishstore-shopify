{% comment %}
  Preguntas frecuentes en acordeón.
  - Cada pregunta es un bloque (pregunta + respuesta). Usa <details>/<summary> nativos:
    accesible y funciona sin JavaScript. Opción para dejar una pregunta abierta al cargar.
  - Icono + / − en el color de acento (gira al abrir).
  - Apertura y cierre animados con assets/accordion.js (altura + fundido de la respuesta).
  - Botón opcional debajo (p. ej. "View more" hacia la página completa de FAQ).
  - Genera datos estructurados FAQPage (JSON-LD) para que Google pueda mostrar las preguntas.
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  <div class="faq full-width" id="faq">
    <div class="faq__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="faq__list">
        {%- for block in section.blocks -%}
          <details
            class="faq__item"
            data-accordion
            {% if block.settings.open %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="faq__question">
              <span>{{ block.settings.question | escape }}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq__answer" data-accordion-content>{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>

      {%- liquid
        assign show_button = false
        if section.settings.button_label != blank
          if section.settings.button_link != blank or pages.faq.url != blank or request.design_mode
            assign show_button = true
          endif
        endif
      -%}
      {%- if show_button -%}
        <div class="faq__footer">
          {%- comment -%} Sin enlace: la página FAQ (identificador "faq") si existe {%- endcomment -%}
          <a href="{{ section.settings.button_link | default: pages.faq.url | default: '#' }}" class="button button--primary faq__button">
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.structured_data -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | strip | json }}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
  <script src="{{ 'accordion.js' | asset_url }}" defer></script>
{%- endif -%}

{% stylesheet %}
  .faq {
    padding-block: 3rem 4rem;
  }

  .faq__inner {
    width: min(41rem, 100% - var(--page-margin) * 2);
    margin-inline: auto;
  }

  .faq__heading {
    margin: 0 0 2.5rem;
    color: #000;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
    text-align: center;
  }

  .faq__item {
    border-bottom: 1px solid #ececec;
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem;
    color: #000;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover {
    color: var(--color-accent);
  }

  .faq__question:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Icono + que pasa a − al abrir (dos líneas con pseudo-elementos) */
  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 0.6875rem;
    height: 0.6875rem;
    color: var(--color-accent);
  }

  .faq__icon::before,
  .faq__icon::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    content: '';
    background-color: currentcolor;
    translate: 0 -50%;
    transition: rotate 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .faq__icon {
    transition: rotate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq__icon::after {
    rotate: 90deg;
  }

  /* Abierta: el icono da media vuelta y queda en "−" (.is-collapsing = cerrándose, lo pone accordion.js) */
  .faq__item[open]:not(.is-collapsing) .faq__icon {
    rotate: 180deg;
  }

  .faq__item[open]:not(.is-collapsing) .faq__icon::after {
    opacity: 0;
    rotate: 0deg;
  }

  .faq__question {
    transition: color 0.2s ease;
  }

  .faq__item[open] .faq__question {
    padding-block-end: 0.375rem;
  }

  .faq__answer {
    padding-block-end: 0.75rem;
    color: #6b6b6b;
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .faq__answer p {
    margin: 0;
  }

  .faq__answer p + p {
    margin-block-start: 0.75rem;
  }

  .faq__footer {
    display: flex;
    justify-content: center;
    margin-block-start: 3.25rem;
  }

  .faq__button {
    min-height: 2.125rem;
    padding: 0.25rem 1.125rem;
    border-radius: 3px;
    font-size: 1.0625rem;
    letter-spacing: 0;
    text-transform: none;
  }

  /* Móvil (diseño del usuario a 375 px): título de 29 px en 2 líneas (interlineado 54), preguntas de 18 px,
     respuestas de 16,5 px y botón "View more" de 155×48 */
  @media (max-width: 749px) {
    .faq__heading {
      max-width: 15rem;
      margin: 0 auto 2.75rem;
      font-size: 1.8125rem;
      line-height: 3.375rem;
    }

    .faq__question {
      padding-block: 2.25rem;
      font-size: 1.125rem;
      line-height: 1.1;
    }

    .faq__icon {
      width: 0.8125rem;
      height: 0.8125rem;
    }

    .faq__item[open] .faq__question {
      padding-block-end: 0.625rem;
    }

    .faq__answer {
      padding-block-end: 1.25rem;
      font-size: 1.0625rem;
      line-height: 1.42;
    }

    .faq__footer {
      margin-block-start: 3.875rem;
    }

    .faq__button {
      min-width: 9.6875rem;
      min-height: 3rem;
    }
  }

  @media (min-width: 750px) {
    .faq {
      padding-block: 4.5rem 7rem;
    }

    .faq__heading {
      margin-block-end: 1.875rem;
      font-size: 1.4375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__icon::before,
    .faq__icon::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq",
  "tag": "section",
  "class": "faq-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "View more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link",
      "info": "t:info.faq_button"
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "t:labels.structured_data",
      "info": "t:info.structured_data",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:general.question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:labels.question",
          "default": "Do you ship across Canada?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:labels.answer",
          "default": "<p>Lorem ipsum dolor sit amet consectetur. Aliquam at in tios tincidunt accumsan tellus egestas diam risus.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "t:labels.open_by_default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.faq",
      "blocks": [
        { "type": "question", "settings": { "question": "What Spanish products can I find in your store?", "open": true } },
        { "type": "question" },
        { "type": "question", "settings": { "question": "How are the products kept fresh during shipping?" } }
      ]
    }
  ]
}
{% endschema %}
