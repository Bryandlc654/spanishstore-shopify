{% comment %}
  Imagen + texto dentro del contenedor (p. ej. "Our story" y "Origin" en Sobre nosotros).
  - Antetítulo rojo opcional, titular, texto enriquecido (párrafos, listas) y botón opcional.
  - Bloques "stat": cifras destacadas (p. ej. "40+" / "Spanish producers") debajo del texto.
  - Imagen a la izquierda o a la derecha, con esquinas redondeadas. Sin imagen, una foto del tema
    elegida en "Default image" (mesa española, tabla de embutidos, despensa o quesos).
  - Fondo: blanco o color con el patrón decorativo opcional.
  - Móvil: imagen arriba y texto debajo.
{% endcomment %}

{%- liquid
  assign image = section.settings.image
  if section.settings.show_pattern
    assign pattern_url = 'pattern-tile.svg' | asset_url
  endif

  case section.settings.default_image
    when 'charcuterie'
      assign default_src = 'tapas-default.jpg'
      assign default_size = '961x600'
    when 'pantry'
      assign default_src = 'collage-default-1.jpg'
      assign default_size = '1024x1024'
    when 'cheese'
      assign default_src = 'product-information-default.jpg'
      assign default_size = '736x736'
    else
      assign default_src = 'shoppable-default.jpg'
      assign default_size = '1774x887'
  endcase
  assign default_dims = default_size | split: 'x'
-%}

<div
  class="content-image full-width{% if section.settings.image_position == 'right' %} content-image--reverse{% endif %}"
  style="--content-image-bg: {{ section.settings.background }};{% if pattern_url %} --content-image-pattern: url('{{ pattern_url }}');{% endif %}"
>
  <div class="content-image__inner">
    <div class="content-image__media">
      {%- if image != blank -%}
        {%- assign image_style = image.presentation.focal_point | default: '50% 50%' | prepend: 'object-position: ' -%}
        {{
          image
          | image_url: width: 1400
          | image_tag:
            class: 'content-image__image',
            alt: image.alt,
            loading: 'lazy',
            widths: '400, 600, 900, 1200, 1400',
            sizes: '(min-width: 750px) 50vw, 100vw',
            style: image_style
        }}
      {%- else -%}
        <img
          class="content-image__image"
          src="{{ default_src | asset_url }}"
          alt=""
          width="{{ default_dims[0] }}"
          height="{{ default_dims[1] }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <div class="content-image__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="content-image__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="content-image__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="content-image__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <dl class="content-image__stats">
          {%- for block in section.blocks -%}
            <div class="content-image__stat" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label | escape }}</dt>
              <dd>{{ block.settings.value | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            href="{{ routes.all_products_collection_url }}"
          {% endif %}
          class="button button--primary content-image__button"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .content-image {
    background-color: var(--content-image-bg);
    background-image: var(--content-image-pattern, none);
    background-size: 3.875rem;
  }

  .content-image__inner {
    display: grid;
    gap: 1.75rem;
    width: min(var(--container-width), 100% - var(--page-margin) * 2);
    margin-inline: auto;
    padding-block: 2.5rem;
  }

  .content-image__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 6px;
    background-color: #f2f2f2;
  }

  .content-image__image {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .content-image__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .content-image__heading {
    margin: 0;
    color: #000;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .content-image__text {
    margin-block-start: 1rem;
    color: #313131;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .content-image__text :is(p, ul, ol) {
    margin: 0 0 0.875rem;
  }

  .content-image__text > :last-child {
    margin-block-end: 0;
  }

  .content-image__text :is(ul, ol) {
    padding-inline-start: 1.125rem;
  }

  .content-image__text li + li {
    margin-block-start: 0.375rem;
  }

  .content-image__text li::marker {
    color: var(--color-accent);
  }

  .content-image__text strong {
    color: #000;
    font-weight: 700;
  }

  .content-image__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding-block-start: 1.5rem;
    border-top: 1px solid #ebe8df;
  }

  .content-image__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }

  .content-image__stat dd {
    margin: 0;
    color: var(--color-accent);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .content-image__stat dt {
    color: #646b7c;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .content-image__button {
    margin-block-start: 1.75rem;
  }

  @media (min-width: 750px) {
    .content-image__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      gap: 4rem;
      padding-block: 4rem;
    }

    .content-image--reverse .content-image__media {
      order: 2;
    }

    .content-image__heading {
      font-size: 2.0625rem;
    }

    .content-image__media {
      aspect-ratio: 1.15;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.content_with_image",
  "tag": "section",
  "class": "content-image-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "default_image",
      "label": "t:labels.default_image",
      "options": [
        { "value": "table", "label": "t:options.content_default_image.table" },
        { "value": "charcuterie", "label": "t:options.content_default_image.charcuterie" },
        { "value": "pantry", "label": "t:options.content_default_image.pantry" },
        { "value": "cheese", "label": "t:options.content_default_image.cheese" }
      ],
      "default": "table"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Bringing the taste of Spain to your table"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Tell your story here.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:labels.background",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "show_pattern",
      "label": "t:labels.show_pattern",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:general.stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:labels.stat_value",
          "default": "40+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label",
          "default": "Spanish producers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.content_with_image"
    }
  ]
}
{% endschema %}
