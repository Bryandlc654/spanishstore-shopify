{% comment %}
  Ficha de producto.
  Columna izquierda: galería (imagen principal + miniaturas) y, debajo, vídeos de clientes (bloques "video").
  En móvil el orden es galería → información y compra → vídeos.
  Columna derecha:
  - Título + icono (i) que abre la descripción, metacampos custom.aging / custom.origin / custom.award,
    precio, nota y valoración (metacampos de reseñas).
  - Selector de variantes (solo si el producto tiene varias).
  - "Unmissable discounts": niveles por cantidad (bloques "tier": unidades, % y código de descuento).
    Cada nivel muestra el precio por unidad con descuento y el precio normal tachado.
    Elegir un nivel cambia la cantidad; el código se aplica al añadir al carrito (/discount/CÓDIGO).
    IMPORTANTE: el tema solo MUESTRA el descuento; el real lo aplica Shopify con ese código.
  - "Complete your purchase": productos del metacampo custom.complementary_products (lista de
    productos), con casilla para añadirlos junto al principal.
  - Entrega estimada + cuenta atrás hasta la hora de corte del envío del día (ajustes).
  - Cantidad, "Add to cart" (AJAX con todos los productos marcados) y botones de pago rápido
    de Shopify (Google Pay / Apple Pay / Shop Pay) + logos de pago.
  - Datos estructurados de producto (JSON-LD de Shopify).
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign currency = cart.currency.iso_code
  assign featured_media = current_variant.featured_media | default: product.featured_media

  assign aging = product.metafields.custom.aging.value
  assign origin = product.metafields.custom.origin.value
  assign award = product.metafields.custom.award.value
  assign complementary = product.metafields.custom.complementary_products.value

  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value

  if collection
    assign crumb_title = collection.title
    assign crumb_url = collection.url
  elsif product.type != blank
    assign crumb_title = product.type
    assign crumb_url = routes.all_products_collection_url
  endif

  assign tier_count = 0
  for block in section.blocks
    if block.type == 'tier'
      assign tier_count = tier_count | plus: 1
    endif
  endfor

  assign offset = 'now' | date: '%z'
  assign offset_hours = offset | slice: 0, 3
  assign offset_minutes = offset | slice: 3, 2
  assign tz_offset = offset_hours | append: ':' | append: offset_minutes
  assign form_id = 'ProductForm-' | append: section.id
-%}

<product-page
  class="main-product full-width"
  data-section-id="{{ section.id }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  data-cart-url="{{ routes.cart_url }}"
  data-root-url="{{ routes.root_url }}"
>
  <div class="main-product__layout">
    <nav class="breadcrumb main-product__breadcrumb" aria-label="{{ 'collections.breadcrumb' | t }}">
      <ol role="list">
        <li><a href="{{ routes.root_url }}">{{ 'collections.home' | t }}</a></li>
        {%- if crumb_title != blank -%}
          <li><a href="{{ crumb_url }}">{{ crumb_title | escape }}</a></li>
        {%- endif -%}
        <li><span aria-current="page">{{ product.title | escape }}</span></li>
      </ol>
    </nav>

    {%- comment -%} Columna izquierda: galería + vídeos {%- endcomment -%}
    <div class="main-product__media">
      <div class="product-gallery">
        <div class="product-gallery__main">
          {%- if featured_media != blank -%}
            {{
              featured_media.preview_image
              | image_url: width: 1400
              | image_tag:
                class: 'product-gallery__image',
                alt: featured_media.alt | default: product.title,
                widths: '480, 720, 960, 1200, 1400',
                sizes: '(min-width: 990px) 480px, 100vw',
                fetchpriority: 'high'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'product-gallery__image product-gallery__image--placeholder' }}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <ul class="product-gallery__thumbs" role="list">
            {%- for media in product.media -%}
              <li>
                <button
                  type="button"
                  class="product-gallery__thumb"
                  data-gallery-thumb
                  data-media-id="{{ media.id }}"
                  data-src="{{ media.preview_image | image_url: width: 1400 }}"
                  data-srcset="{{ media.preview_image | image_url: width: 480 }} 480w, {{ media.preview_image | image_url: width: 960 }} 960w, {{ media.preview_image | image_url: width: 1400 }} 1400w"
                  data-alt="{{ media.alt | default: product.title | escape }}"
                  aria-label="{{ 'products.view_image' | t: number: forloop.index }}"
                  {% if media.id == featured_media.id %}
                    aria-current="true"
                  {% endif %}
                >
                  {{ media.preview_image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy' }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Móvil: todas las imágenes en un carrusel deslizable con puntos {%- endcomment -%}
      {%- if product.media.size > 0 -%}
        <scroll-dots class="product-gallery-mobile">
          <ul class="product-gallery-mobile__track" role="list" data-scroll-track>
            {%- for media in product.media -%}
              <li class="product-gallery-mobile__slide">
                {{
                  media.preview_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'product-gallery-mobile__image',
                    alt: media.alt | default: product.title,
                    widths: '400, 600, 900',
                    sizes: '85vw',
                    loading: 'lazy'
                }}
              </li>
            {%- endfor -%}
          </ul>
          {%- if product.media.size > 1 -%}
            <div class="scroll-dots">
              {%- for media in product.media -%}
                <button
                  type="button"
                  class="scroll-dots__dot"
                  aria-label="{{ 'products.view_image' | t: number: forloop.index }}"
                  {% if forloop.first %}
                    aria-current="true"
                  {% endif %}
                  data-dot-index="{{ forloop.index0 }}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </scroll-dots>
      {%- endif -%}
    </div>

    {%- comment -%} Columna derecha: información y compra {%- endcomment -%}
    <div class="main-product__info">
      <div class="product-info__title-row">
        <h1 class="product-info__title">{{ product.title | escape }}</h1>
        {%- if product.description != blank -%}
          <details class="product-info__description">
            <summary aria-label="{{ 'products.description' | t }}">
              {{- 'icon-info.svg' | inline_asset_content -}}
            </summary>
            <div class="product-info__description-panel rte">{{ product.description }}</div>
          </details>
        {%- endif -%}
      </div>

      {%- if aging != blank or origin != blank -%}
        <p class="product-info__meta">
          {%- if aging != blank -%}<span>{{ aging | escape }}</span>{%- endif -%}
          {%- if origin != blank -%}<span>{{ 'products.origin' | t }}: {{ origin | escape }}</span>{%- endif -%}
        </p>
      {%- endif -%}

      {%- if award != blank -%}
        <p class="product-info__award">
          {{- 'icon-award.svg' | inline_asset_content -}}
          <span>{{ award | escape }}</span>
        </p>
      {%- endif -%}

      <div class="product-info__price" data-price>
        <span class="product-info__price-current">{{ current_variant.price | money_without_currency }} {{ currency }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s class="product-info__price-compare">
            {{- current_variant.compare_at_price | money_without_currency }} {{ currency -}}
          </s>
        {%- endif -%}
      </div>
      {%- if section.settings.tax_note != blank -%}
        <p class="product-info__note">{{ section.settings.tax_note | escape }}</p>
      {%- endif -%}

      {%- if rating != blank -%}
        {%- assign rating_out_of_5 = rating.rating | times: 5.0 | divided_by: rating.scale_max | round: 1 -%}
        <div class="product-info__rating">
          <span
            class="rating-stars"
            style="--rating: {{ rating_out_of_5 }};"
            role="img"
            aria-label="{{ 'accessibility.rating' | t: rating: rating_out_of_5, max: 5 }}"
          ></span>
          {%- if rating_count != blank -%}
            <span>{{ 'products.reviews_count' | t: count: rating_count }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, id: form_id, class: 'product-buy', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          <div class="product-variants">
            {%- for option in product.options_with_values -%}
              <div class="product-variants__option">
                <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name | escape }}</label>
                <div class="product-variants__select">
                  <select id="Option-{{ section.id }}-{{ forloop.index0 }}" data-option-index="{{ forloop.index0 }}">
                    {%- for value in option.values -%}
                      <option
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}
                          selected
                        {% endif %}
                      >
                        {{- value | escape -}}
                      </option>
                    {%- endfor -%}
                  </select>
                  {{- 'icon-chevron-down.svg' | inline_asset_content -}}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- if tier_count > 0 -%}
          <fieldset class="product-tiers">
            <legend class="product-info__subheading">{{ section.settings.tiers_heading | escape }}</legend>
            <div class="product-tiers__list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'tier' -%}
                  {%- liquid
                    comment
                      Precio por unidad con el descuento del nivel (como en el diseño: baja al subir la cantidad)
                    endcomment
                    assign tier_qty = block.settings.quantity
                    assign tier_regular = current_variant.price
                    assign keep = 100 | minus: block.settings.discount
                    assign tier_total = tier_regular | times: keep | divided_by: 100
                  -%}
                  <label class="product-tier" {{ block.shopify_attributes }}>
                    <input
                      type="radio"
                      name="tier-{{ section.id }}"
                      class="product-tier__input"
                      value="{{ tier_qty }}"
                      data-tier
                      data-quantity="{{ tier_qty }}"
                      data-discount="{{ block.settings.discount }}"
                      data-code="{{ block.settings.discount_code | strip | escape }}"
                    >
                    {%- if block.settings.ribbon != blank -%}
                      <span class="product-tier__ribbon">{{ block.settings.ribbon | escape }}</span>
                    {%- endif -%}
                    <span class="product-tier__radio" aria-hidden="true"></span>
                    <span class="product-tier__units">{{ 'products.units' | t: count: tier_qty }}</span>
                    <span class="product-tier__row">
                      <span class="product-tier__badge">{{ 'products.percent_off' | t: percent: block.settings.discount }}</span>
                      <span class="product-tier__prices">
                        <span class="product-tier__total" data-tier-total>{{ tier_total | money_without_currency }} {{ currency }}</span>
                        <s class="product-tier__regular" data-tier-regular>{{ tier_regular | money_without_currency }} {{ currency }}</s>
                      </span>
                    </span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        {%- if complementary.size > 0 -%}
          {%- liquid
            assign xsell_count = 0
            for item in complementary limit: 2
              if item.available
                assign xsell_count = xsell_count | plus: 1
              endif
            endfor
          -%}
          <scroll-dots class="product-xsell">
            <h2 class="product-info__subheading">{{ section.settings.xsell_heading | escape }}</h2>
            <ul class="product-xsell__list" role="list" data-scroll-track>
              {%- for item in complementary limit: 2 -%}
                {%- assign item_variant = item.selected_or_first_available_variant -%}
                {%- if item.available -%}
                  <li>
                    <label class="product-xsell__card">
                      <input
                        type="checkbox"
                        class="product-xsell__input"
                        value="{{ item_variant.id }}"
                        data-xsell
                        {% if section.settings.xsell_checked %}
                          checked
                        {% endif %}
                      >
                      <span class="product-xsell__check" aria-hidden="true">{{- 'icon-check.svg' | inline_asset_content -}}</span>
                      <span class="product-xsell__media">
                        {%- if item.featured_media != blank -%}
                          {{ item.featured_media | image_url: width: 300 | image_tag: alt: '', loading: 'lazy' }}
                        {%- endif -%}
                      </span>
                      <span class="product-xsell__body">
                        <span class="product-xsell__title">{{ item.title | escape }}</span>
                        <span class="product-xsell__price">{{ item_variant.price | money_without_currency }} {{ currency }}</span>
                        {%- if section.settings.tax_note != blank -%}
                          <span class="product-xsell__note">{{ section.settings.tax_note | escape }}</span>
                        {%- endif -%}
                      </span>
                    </label>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            {%- if xsell_count > 1 -%}
              <div class="scroll-dots">
                {%- for i in (1..xsell_count) -%}
                  <button
                    type="button"
                    class="scroll-dots__dot"
                    aria-label="{{ 'sections.features.go_to' | t: number: forloop.index, count: xsell_count }}"
                    {% if forloop.first %}
                      aria-current="true"
                    {% endif %}
                    data-dot-index="{{ forloop.index0 }}"
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </scroll-dots>
        {%- endif -%}

        {%- if section.settings.show_delivery -%}
          <div
            class="product-delivery"
            data-delivery
            data-cutoff="{{ section.settings.cutoff_time | strip | escape }}"
            data-offset="{{ tz_offset }}"
            data-days="{{ section.settings.dispatch_days | strip | escape }}"
          >
            {{- 'icon-truck.svg' | inline_asset_content -}}
            <div>
              <p class="product-delivery__title">{{ section.settings.delivery_heading | escape }}</p>
              <p class="product-delivery__text" data-delivery-text hidden></p>
            </div>
          </div>
        {%- endif -%}

        <div class="product-quantity">
          <label for="Quantity-{{ section.id }}">{{ 'products.select_quantity' | t }}</label>
          <div class="product-quantity__stepper">
            <button type="button" aria-label="{{ 'products.decrease_quantity' | t }}" data-quantity-step="-1">−</button>
            <input
              id="Quantity-{{ section.id }}"
              type="number"
              name="quantity"
              value="1"
              min="1"
              inputmode="numeric"
              data-quantity
            >
            <button type="button" aria-label="{{ 'products.increase_quantity' | t }}" data-quantity-step="1">+</button>
          </div>
        </div>

        <button
          type="submit"
          name="add"
          class="button button--primary product-form__submit"
          data-add-button
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          {%- if current_variant.available -%}
            {{ 'products.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.sold_out' | t }}
          {%- endif -%}
        </button>
        <p class="product-form__error" role="alert" data-form-error hidden></p>

        {%- if section.settings.show_dynamic_checkout -%}
          <div class="product-form__dynamic">{{ form | payment_button }}</div>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.show_payment_icons -%}
        {%- if shop.enabled_payment_types.size > 0 -%}
          <ul class="product-info__payments" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          {%- comment -%} Sin métodos activados (tienda en pruebas): los logos del diseño {%- endcomment -%}
          <p class="product-info__payments product-info__payments--image">
            <img
              src="{{ 'payment-icons.png' | asset_url }}"
              alt="{{ 'footer.payment_methods_list' | t }}"
              width="319"
              height="53"
              loading="lazy"
            >
          </p>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- comment -%} En la tienda solo cuentan los vídeos con contenido; en el editor se ven todos {%- endcomment -%}
    {%- assign has_videos = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'video' -%}
        {%- if request.design_mode or block.settings.video != blank or block.settings.video_url != blank or block.settings.cover != blank -%}
          {%- assign has_videos = true -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if has_videos -%}
      <div class="product-ugc main-product__ugc">
        {%- if section.settings.ugc_heading != blank -%}
          <h2 class="product-ugc__heading">{{ section.settings.ugc_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.ugc_text != blank -%}
          <p class="product-ugc__text">{{ section.settings.ugc_text | escape }}</p>
        {%- endif -%}
        <ul class="product-ugc__list" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign show_video = false
              if block.type == 'video'
                if request.design_mode or block.settings.video != blank or block.settings.video_url != blank or block.settings.cover != blank
                  assign show_video = true
                endif
              endif
            -%}
            {%- if show_video -%}
              <li {{ block.shopify_attributes }}>
                {%- render 'video-card',
                  video: block.settings.video,
                  video_url: block.settings.video_url,
                  cover: block.settings.cover,
                  label: block.settings.title,
                  placeholder_index: forloop.index0,
                  sizes: '(min-width: 990px) 150px, 33vw'
                -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "price": {{ variant.price }},
            "compare_at_price": {{ variant.compare_at_price | default: 0 }},
            "available": {{ variant.available }},
            "options": {{ variant.options | json }},
            "media_id": {{ variant.featured_media.id | default: 'null' }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "currency": {{ currency | json }},
      "strings": {
        "addToCart": {{ 'products.add_to_cart' | t | json }},
        "adding": {{ 'pack.adding' | t | json }},
        "soldOut": {{ 'products.sold_out' | t | json }},
        "unavailable": {{ 'products.unavailable' | t | json }},
        "error": {{ 'pack.error' | t | json }},
        "dispatchToday": {{ 'products.dispatch_today' | t: time: '__TIME__' | json }},
        "dispatchNext": {{ 'products.dispatch_next' | t: time: '__TIME__' | json }}
      }
    }
  </script>
</product-page>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% stylesheet %}
  .main-product {
    display: block;
    padding-block: 1.25rem 3rem;
  }

  .main-product__layout {
    display: grid;
    grid-template-areas:
      'crumbs'
      'media'
      'info'
      'ugc';
    gap: 1.25rem;
    width: min(var(--container-width), 100% - var(--page-margin) * 2);
    margin-inline: auto;
  }

  .main-product__breadcrumb {
    grid-area: crumbs;
  }

  .main-product__media {
    grid-area: media;
    min-width: 0;
  }

  .main-product__info {
    grid-area: info;
    min-width: 0;
  }

  .main-product__ugc {
    grid-area: ugc;
    min-width: 0;
  }

  /* Galería */
  .product-gallery__main {
    aspect-ratio: 479 / 362;
    overflow: hidden;
    border-radius: 6px;
    background-color: #f2f2f2;
  }

  .product-gallery__image {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .product-gallery__image--placeholder {
    fill: #c9c9c9;
  }

  .product-gallery__thumbs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 0.8125rem * 3) / 4);
    gap: 0.8125rem;
    margin: 0.8125rem 0 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
  }

  .product-gallery__thumb {
    display: block;
    width: 100%;
    aspect-ratio: 111 / 100;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 6px;
    background: #f2f2f2;
    cursor: pointer;
  }

  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery__thumb[aria-current='true'] {
    border-color: var(--color-accent);
  }

  .product-gallery__thumb:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Vídeos de clientes */
  .product-ugc {
    margin-block-start: 1.25rem;
  }

  .product-ugc__heading {
    margin: 0;
    color: #000;
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .product-ugc__text {
    margin: 0.5rem 0 0;
    color: #6f6f6f;
    font-size: 0.875rem;
  }

  .product-ugc__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8125rem;
    margin: 1.375rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* Información */
  .product-info__title-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .product-info__title {
    margin: 0;
    color: #000;
    font-size: 1.375rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .product-info__description {
    position: relative;
  }

  .product-info__description summary {
    display: flex;
    color: var(--color-accent);
    list-style: none;
    cursor: pointer;
  }

  .product-info__description summary::-webkit-details-marker {
    display: none;
  }

  .product-info__description summary svg {
    width: 1rem;
    height: 1rem;
  }

  .product-info__description-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    z-index: 5;
    width: min(22rem, 80vw);
    max-height: 20rem;
    overflow-y: auto;
    padding: 1rem 1.125rem;
    border: 1px solid #f4f0e2;
    border-radius: 6px;
    background-color: #fff;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.12);
    font-size: 0.9375rem;
    line-height: 1.5;
    translate: -50% 0;
  }

  .product-info__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: 0.75rem 0 0;
    color: #6f6f6f;
    font-size: 0.875rem;
  }

  .product-info__meta span + span::before {
    margin-inline-end: 0.5rem;
    content: '•';
  }

  .product-info__award {
    display: flex;
    align-items: center;
