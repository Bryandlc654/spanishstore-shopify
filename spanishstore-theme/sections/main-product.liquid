{% javascript %}
  // Carrusel con puntos (galería y complementarios en móvil)
  class ScrollDots extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-scroll-track]');
      this.dots = [...this.querySelectorAll('[data-dot-index]')];
      if (!this.track || !this.dots.length) return;
      this.dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const item = this.track.children[Number(dot.dataset.dotIndex)];
          if (item) this.track.scrollTo({ left: item.offsetLeft - this.track.firstElementChild.offsetLeft, behavior: 'smooth' });
        });
      });
      this.track.addEventListener('scroll', () => this.update(), { passive: true });
      this.update();
    }

    update() {
      const first = this.track.firstElementChild;
      if (!first) return;
      const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
      const max = this.track.scrollWidth - this.track.clientWidth;
      let index = Math.round(this.track.scrollLeft / (first.offsetWidth + gap));
      if (this.track.scrollLeft >= max - 2) index = this.dots.length - 1;
      index = Math.min(index, this.dots.length - 1);
      this.dots.forEach((dot, n) => {
        if (n === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    }
  }

  if (!customElements.get('scroll-dots')) {
    customElements.define('scroll-dots', ScrollDots);
  }
  class ProductPage extends HTMLElement {
    connectedCallback() {
      const data = JSON.parse(this.querySelector('[data-product-json]').textContent);
      this.variants = data.variants;
      this.strings = data.strings;
      this.currency = data.currency;
      this.form = this.querySelector('.product-buy');
      this.quantity = this.querySelector('[data-quantity]');
      this.variantInput = this.querySelector('[data-variant-id]');
      this.addButton = this.querySelector('[data-add-button]');
      this.error = this.querySelector('[data-form-error]');
      this.variant = this.variants.find((v) => v.id === Number(this.variantInput.value)) || this.variants[0];

      // Galería
      this.querySelectorAll('[data-gallery-thumb]').forEach((thumb) =>
        thumb.addEventListener('click', () => this.showMedia(thumb))
      );

      // Variantes
      this.querySelectorAll('[data-option-index]').forEach((select) =>
        select.addEventListener('change', () => this.updateVariant())
      );

      // Niveles: elegir uno cambia la cantidad
      this.querySelectorAll('[data-tier]').forEach((tier) =>
        tier.addEventListener('change', () => {
          this.quantity.value = tier.dataset.quantity;
        })
      );

      // Cantidad: botones +/- y sincronía con los niveles
      this.querySelectorAll('[data-quantity-step]').forEach((button) =>
        button.addEventListener('click', () => {
          const next = Math.max(1, (Number(this.quantity.value) || 1) + Number(button.dataset.quantityStep));
          this.quantity.value = next;
          this.syncTier();
        })
      );
      this.quantity.addEventListener('change', () => {
        this.quantity.value = Math.max(1, Math.floor(Number(this.quantity.value) || 1));
        this.syncTier();
      });

      this.form?.addEventListener('submit', (event) => this.submit(event));
      this.startDelivery();
    }

    showMedia(thumb) {
      const main = this.querySelector('.product-gallery__main img');
      if (main) {
        main.src = thumb.dataset.src;
        main.srcset = thumb.dataset.srcset;
        main.alt = thumb.dataset.alt;
      }
      this.querySelectorAll('[data-gallery-thumb]').forEach((t) => t.toggleAttribute('aria-current', t === thumb));
      thumb.setAttribute('aria-current', 'true');
    }

    updateVariant() {
      const selected = [...this.querySelectorAll('[data-option-index]')].map((select) => select.value);
      const variant = this.variants.find((v) => v.options.every((value, i) => value === selected[i]));
      this.variant = variant;

      if (!variant) {
        this.addButton.disabled = true;
        this.addButton.textContent = this.strings.unavailable;
        return;
      }
      this.variantInput.value = variant.id;
      this.addButton.disabled = !variant.available;
      this.addButton.textContent = variant.available ? this.strings.addToCart : this.strings.soldOut;

      const price = this.querySelector('[data-price]');
      price.innerHTML = `<span class="product-info__price-current">${this.money(variant.price)}</span>${
        variant.compare_at_price > variant.price
          ? `<s class="product-info__price-compare">${this.money(variant.compare_at_price)}</s>`
          : ''
      }`;

      // Precio por unidad de cada nivel
      this.querySelectorAll('[data-tier]').forEach((tier) => {
        const regular = variant.price;
        const total = Math.round((regular * (100 - Number(tier.dataset.discount))) / 100);
        const card = tier.closest('.product-tier');
        card.querySelector('[data-tier-total]').textContent = this.money(total);
        card.querySelector('[data-tier-regular]').textContent = this.money(regular);
      });

      if (variant.media_id) {
        const thumb = this.querySelector(`[data-gallery-thumb][data-media-id="${variant.media_id}"]`);
        if (thumb) this.showMedia(thumb);
      }

      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      history.replaceState({}, '', url);
    }

    syncTier() {
      const qty = Number(this.quantity.value);
      this.querySelectorAll('[data-tier]').forEach((tier) => {
        tier.checked = Number(tier.dataset.quantity) === qty;
      });
    }

    // Precio en formato "9.29 CAD", igual que las tarjetas
    money(cents) {
      return `${(cents / 100).toFixed(2)} ${this.currency}`;
    }

    async submit(event) {
      event.preventDefault();
      if (!this.variant || this.addButton.disabled) return;
      this.error.hidden = true;
      this.addButton.disabled = true;
      this.addButton.textContent = this.strings.adding;

      const items = [{ id: this.variant.id, quantity: Math.max(1, Number(this.quantity.value) || 1) }];
      this.querySelectorAll('[data-xsell]:checked').forEach((input) => items.push({ id: Number(input.value), quantity: 1 }));

      // Si la cantidad coincide con un nivel con código, se aplica el descuento al carrito
      const tier = this.querySelector('[data-tier]:checked');
      const code = tier && Number(tier.dataset.quantity) === items[0].quantity ? tier.dataset.code : '';

      try {
        if (window.themeCart) {
          // assets/cart.js: añade, aplica el código y abre el carrito lateral
          await window.themeCart.add(items, { discountCode: code });
          this.addButton.disabled = false;
          this.addButton.textContent = this.strings.addToCart;
          return;
        }

        const response = await fetch(this.dataset.cartAddUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items }),
        });
        if (!response.ok) {
          const data = await response.json().catch(() => ({}));
          throw new Error(data.description || data.message || this.strings.error);
        }

        const cartUrl = this.dataset.cartUrl;
        window.location.href = code
          ? `${this.dataset.rootUrl.replace(/\/$/, '')}/discount/${encodeURIComponent(code)}?redirect=${encodeURIComponent(cartUrl)}`
          : cartUrl;
      } catch (error) {
        this.error.textContent = error.message || this.strings.error;
        this.error.hidden = false;
        this.addButton.disabled = false;
        this.addButton.textContent = this.strings.addToCart;
      }
    }

    // "Order within 02h 15m for today's dispatch": cuenta atrás hasta la hora de corte
    startDelivery() {
      const box = this.querySelector('[data-delivery]');
      const text = box?.querySelector('[data-delivery-text]');
      const match = /^(\d{1,2}):(\d{2})$/.exec(box?.dataset.cutoff || '');
      if (!box || !text || !match) return;

      const days = (box.dataset.days || '1,2,3,4,5').split(',').map(Number);
      const offset = box.dataset.offset || '+00:00';
      const sign = offset.startsWith('-') ? -1 : 1;
      const [oh, om] = offset.slice(1).split(':').map(Number);
      const offsetMs = sign * (oh * 60 + om) * 60000;

      const update = () => {
        // "Ahora" en la hora de la tienda
        const now = new Date(Date.now() + offsetMs);
        let target = new Date(now);
        target.setUTCHours(Number(match[1]), Number(match[2]), 0, 0);
        let today = days.includes(now.getUTCDay()) && target > now;
        if (!today) {
          do {
            target.setUTCDate(target.getUTCDate() + 1);
          } while (!days.includes(target.getUTCDay()));
        }
        const minutes = Math.max(0, Math.floor((target - now) / 60000));
        const hours = Math.floor(minutes / 60);
        const time = `${String(hours).padStart(2, '0')}h ${String(minutes % 60).padStart(2, '0')}m`;
        const template = today ? this.strings.dispatchToday : this.strings.dispatchNext;
        text.innerHTML = template.replace('__TIME__', `<strong>${time}</strong>`);
        text.hidden = false;
      };
      update();
      setInterval(update, 30000);
    }
  }

  if (!customElements.get('product-page')) {
    customElements.define('product-page', ProductPage);
  }
{% endjavascript %}

