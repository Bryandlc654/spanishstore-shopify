{% comment %}
  Página de preguntas frecuentes agrupadas por temas (pedidos, envíos y plazos, conservación,
  pagos, devoluciones…).
  - Bloques "topic": empiezan un grupo (título del tema). Los bloques "question" que vienen
    detrás pertenecen a ese tema (el orden de los bloques define los grupos).
  - Desktop: índice de temas fijo a la izquierda (enlaces a cada grupo, se marca el que se ve)
    y acordeones a la derecha. Móvil: temas en píldoras con scroll horizontal.
  - Buscador: filtra las preguntas mientras se escribe (sin recargar) y abre las que coinciden.
  - Acordeón con <details>/<summary> (accesible y funciona sin JavaScript).
  - Datos estructurados FAQPage (JSON-LD) con todas las preguntas.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = page.title
  endif
  assign question_count = 0
  for block in section.blocks
    if block.type == 'question'
      assign question_count = question_count | plus: 1
    endif
  endfor
-%}

<faq-page class="faq-page full-width">
  <nav class="breadcrumb faq-page__breadcrumb" aria-label="{{ 'collections.breadcrumb' | t }}">
    <ol role="list">
      <li><a href="{{ routes.root_url }}">{{ 'collections.home' | t }}</a></li>
      <li><span aria-current="page">{{ heading | escape }}</span></li>
    </ol>
  </nav>

  <header class="faq-page__header">
    <h1 class="faq-page__title">{{ heading | escape }}</h1>
    {%- if page.content != blank -%}
      <div class="faq-page__intro">{{ page.content }}</div>
    {%- elsif section.settings.intro != blank -%}
      <div class="faq-page__intro">{{ section.settings.intro }}</div>
    {%- endif -%}
  </header>

  <div class="faq-page__layout">
    <aside class="faq-page__aside">
      {%- if section.settings.show_search -%}
        <div class="faq-page__search">
          {{- 'icon-search.svg' | inline_asset_content -}}
          <input
            type="search"
            class="faq-page__search-input"
            placeholder="{{ 'faq.search_placeholder' | t }}"
            aria-label="{{ 'faq.search_placeholder' | t }}"
            data-faq-search
          >
        </div>
      {%- endif -%}

      <nav class="faq-topics" aria-label="{{ 'faq.topics' | t }}">
        <ul class="faq-topics__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'topic' -%}
              {%- assign topic_id = 'faq-' | append: block.settings.title | handleize -%}
              <li>
                <a href="#{{ topic_id }}" class="faq-topics__link" data-faq-topic-link>
                  {{- block.settings.title | escape -}}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    </aside>

    <div class="faq-page__groups">
      {%- comment -%} Preguntas antes del primer tema: grupo sin título {%- endcomment -%}
      {%- if section.blocks.first.type == 'question' -%}
        <section class="faq-group" data-faq-group>
          <div class="faq-group__list">
            {%- for question in section.blocks -%}
              {%- if question.type == 'topic' -%}{%- break -%}{%- endif -%}
              {%- render 'faq-item', block: question -%}
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'topic' -%}
          {%- assign topic_id = 'faq-' | append: block.settings.title | handleize -%}
          {%- assign start = forloop.index -%}
          <section
            class="faq-group"
            id="{{ topic_id }}"
            aria-labelledby="{{ topic_id }}-title"
            data-faq-group
            {{ block.shopify_attributes }}
          >
            <h2 class="faq-group__title" id="{{ topic_id }}-title">{{ block.settings.title | escape }}</h2>
            <div class="faq-group__list">
              {%- for question in section.blocks offset: start -%}
                {%- if question.type == 'topic' -%}{%- break -%}{%- endif -%}
                {%- render 'faq-item', block: question -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}
      {%- endfor -%}

      <p class="faq-page__empty" role="status" data-faq-empty hidden>{{ 'faq.no_results' | t }}</p>
    </div>
  </div>
</faq-page>

{%- if question_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign written = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' -%}
            {%- if written > 0 %},{% endif -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | strip | json }}
              }
            }
            {%- assign written = written | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<script src="{{ 'accordion.js' | asset_url }}" defer></script>

{% stylesheet %}
  .faq-page {
    display: block;
    width: min(var(--container-width), 100% - var(--page-margin) * 2);
    margin-inline: auto;
    padding-block: 0.875rem 3rem;
  }

  .faq-page__header {
    margin-block: 1.375rem 1.5rem;
  }

  .faq-page__title {
    margin: 0;
    color: #000;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .faq-page__intro {
    max-width: 40rem;
    margin-block-start: 0.5rem;
    color: #313131;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.5;
  }

  .faq-page__intro p {
    margin: 0;
  }

  .faq-page__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .faq-page__aside {
    min-width: 0;
  }

  /* Buscador */
  .faq-page__search {
    position: relative;
    display: flex;
    align-items: center;
  }

  .faq-page__search svg {
    position: absolute;
    left: 0.875rem;
    width: 1rem;
    height: 1rem;
    color: #646b7c;
    pointer-events: none;
  }

  .faq-page__search-input {
    width: 100%;
    min-height: 2.625rem;
    padding: 0.5rem 0.875rem 0.5rem 2.5rem;
    border: 1px solid #f3efe0;
    border-radius: 3px;
    background-color: #fff;
    font-size: 0.9375rem;
  }

  .faq-page__search-input:focus {
    border-color: #79819a;
    outline: none;
  }

  .faq-page__search-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  /* Temas: píldoras en móvil, índice en desktop */
  .faq-topics {
    margin-block-start: 1rem;
    margin-inline: calc(var(--page-margin) * -1);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .faq-topics::-webkit-scrollbar {
    display: none;
  }

  .faq-topics__list {
    display: flex;
    gap: 0.5rem;
    width: max-content;
    margin: 0;
    padding: 0 var(--page-margin);
    list-style: none;
  }

  .faq-topics__link {
    display: inline-flex;
    align-items: center;
    min-height: 1.6875rem;
    padding: 0.25rem 1.25rem;
    border: 1px solid #f4f0e2;
    border-radius: 2rem;
    color: #000;
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .faq-topics__link:hover {
    color: var(--color-accent);
  }

  .faq-topics__link[aria-current='true'] {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    color: #fff;
  }

  /* Grupos y acordeón (mismo estilo que la sección FAQ) */
  .faq-group {
    scroll-margin-top: calc(var(--header-height, 0px) + 1.5rem);
  }

  .faq-group + .faq-group {
    margin-block-start: 2.5rem;
  }

  .faq-group__title {
    margin: 0;
    padding-block-end: 0.5rem;
    border-bottom: 2px solid var(--color-accent);
    color: #000;
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .faq-page__item {
    border-bottom: 1px solid #ececec;
  }

  .faq-page__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    color: #000;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }

  .faq-page__question::-webkit-details-marker {
    display: none;
  }

  .faq-page__question:hover {
    color: var(--color-accent);
  }

  .faq-page__question:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .faq-page__icon {
    position: relative;
    flex-shrink: 0;
    width: 0.6875rem;
    height: 0.6875rem;
    color: var(--color-accent);
  }

  .faq-page__icon::before,
  .faq-page__icon::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    content: '';
    background-color: currentcolor;
    translate: 0 -50%;
    transition: rotate 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .faq-page__icon {
    transition: rotate 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-page__icon::after {
    rotate: 90deg;
  }

  /* Abierta: el icono da media vuelta y queda en "−" (.is-collapsing = cerrándose, lo pone accordion.js) */
  .faq-page__item[open]:not(.is-collapsing) .faq-page__icon {
    rotate: 180deg;
  }

  .faq-page__item[open]:not(.is-collapsing) .faq-page__icon::after {
    opacity: 0;
    rotate: 0deg;
  }

  .faq-page__question {
    transition: color 0.2s ease;
  }

  .faq-page__item[open] .faq-page__question {
    padding-block-end: 0.375rem;
  }

  .faq-page__answer {
    padding-block-end: 1.25rem;
    color: #6f6f6f;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .faq-page__answer :is(p, ul, ol) {
    margin: 0;
  }

  .faq-page__answer :is(p, ul, ol) + :is(p, ul, ol) {
    margin-block-start: 0.75rem;
  }

  .faq-page__answer a {
    color: var(--color-accent);
  }

  .faq-page__empty {
    margin: 1rem 0 0;
    color: #6f6f6f;
    font-size: 0.9375rem;
  }

  @media (min-width: 990px) {
    .faq-page {
      padding-block-start: 1.0625rem;
    }

    .faq-page__header {
      margin-block: 1.6875rem 2rem;
    }

    .faq-page__title {
      font-size: 1.4375rem;
    }

    .faq-page__layout {
      grid-template-columns: 16.9375rem minmax(0, 1fr);
      align-items: start;
      gap: 4rem;
    }

    .faq-page__aside {
      position: sticky;
      top: calc(var(--header-height, 0px) + 1.5rem);
      padding: 1.375rem 1.3125rem;
      border: 1px solid #f4f0e2;
      border-radius: 8px;
    }

    .faq-topics {
      margin-inline: 0;
      overflow: visible;
    }

    .faq-topics__list {
      flex-direction: column;
      gap: 0.25rem;
      width: auto;
      padding: 0;
    }

    .faq-topics__link {
      display: flex;
      min-height: 2.25rem;
      padding: 0.375rem 0.875rem;
      border: 0;
      border-radius: 4px;
      font-size: 0.9375rem;
    }

    .faq-topics__link[aria-current='true'] {
      background-color: #faf8f1;
      color: var(--color-accent);
      box-shadow: inset 2px 0 0 var(--color-accent);
    }

    .faq-group__title {
      font-size: 1.1875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-page__icon,
    .faq-page__icon::before,
    .faq-page__icon::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class FaqPage extends HTMLElement {
    connectedCallback() {
      this.items = [...this.querySelectorAll('[data-faq-item]')];
      this.groups = [...this.querySelectorAll('[data-faq-group]')];
      this.links = [...this.querySelectorAll('[data-faq-topic-link]')];
      this.search = this.querySelector('[data-faq-search]');
      this.empty = this.querySelector('[data-faq-empty]');
      this.search?.addEventListener('input', () => this.filter(this.search.value));
      this.watchTopics();
    }

    // Sin tildes y en minúsculas para comparar
    normalize(text) {
      return text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '');
    }

    filter(value) {
      const query = this.normalize(value.trim());
      let visible = 0;
      this.items.forEach((item) => {
        const match = !query || this.normalize(item.textContent).includes(query);
        item.hidden = !match;
        if (query.length >= 3) item.open = match;
        if (match) visible += 1;
      });
      this.groups.forEach((group) => {
        group.hidden = !group.querySelector('[data-faq-item]:not([hidden])');
      });
      if (this.empty) this.empty.hidden = visible > 0;
    }

    // Marca en el índice el tema que se está viendo
    watchTopics() {
      if (!this.links.length) return;
      this.links[0].setAttribute('aria-current', 'true');
      if (!('IntersectionObserver' in window)) return;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            this.links.forEach((link) => {
              link.setAttribute('aria-current', String(link.hash === `#${entry.target.id}`));
            });
          });
        },
        { rootMargin: '-20% 0px -70% 0px' }
      );
      this.groups.filter((group) => group.id).forEach((group) => observer.observe(group));
    }
  }

  if (!customElements.get('faq-page')) {
    customElements.define('faq-page', FaqPage);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.faq_page",
  "tag": "section",
  "class": "faq-page-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.contact_heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:labels.text",
      "info": "t:info.contact_intro"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_faq_search",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "t:general.faq_topic",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Orders"
        }
      ]
    },
    {
      "type": "question",
      "name": "t:general.question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:labels.question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:labels.answer",
          "default": "<p>Answer</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "t:labels.open_by_default",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
