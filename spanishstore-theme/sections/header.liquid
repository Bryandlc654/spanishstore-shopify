{% javascript %}
  class HeaderDrawer extends HTMLElement {
    connectedCallback() {
      this.dialog = this.querySelector('dialog');
      this.toggle = this.querySelector('[data-drawer-open]');
      if (!this.dialog || !this.toggle) return;

      this.toggle.addEventListener('click', () => this.open());
      this.querySelectorAll('[data-drawer-close]').forEach((button) => {
        button.addEventListener('click', () => this.close());
      });

      // Cerrar al pulsar fuera del panel (sobre el fondo oscuro)
      this.dialog.addEventListener('click', (event) => {
        if (event.target === this.dialog) this.close();
      });
      this.dialog.addEventListener('close', () => {
        this.toggle.setAttribute('aria-expanded', 'false');
        this.showMain();
      });
      // Esc también cierra con animación
      this.dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        this.close();
      });

      // Categoría con subcategorías: su panel sustituye a la lista; la ✕ roja vuelve a la lista
      this.main = this.querySelector('[data-drawer-main]');
      this.querySelectorAll('[data-drawer-panel]').forEach((button) => {
        button.addEventListener('click', () => this.showPanel(button));
      });
      this.querySelectorAll('[data-drawer-back]').forEach((button) => {
        button.addEventListener('click', () => this.showMain(true));
      });

      // Si se pasa a desktop con el panel abierto, se cierra
      window.matchMedia('(min-width: 990px)').addEventListener('change', (event) => {
        if (event.matches) this.close();
      });
    }

    showPanel(button) {
      const panel = this.querySelector(`#${button.dataset.drawerPanel}`);
      if (!panel || !this.main) return;
      this.activeButton = button;
      this.main.hidden = true;
      panel.hidden = false;
      button.setAttribute('aria-expanded', 'true');
      panel.querySelector('.drawer__panel-title')?.focus();
    }

    showMain(focus = false) {
      if (!this.main) return;
      this.querySelectorAll('.drawer__panel').forEach((panel) => (panel.hidden = true));
      this.main.hidden = false;
      this.querySelectorAll('[data-drawer-panel]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
      if (focus) this.activeButton?.focus();
    }

    open() {
      loadDeferredImages(this.dialog);
      this.dialog.showModal();
      this.toggle.setAttribute('aria-expanded', 'true');
    }

    // Cierre animado (con "reducir movimiento" se cierra al momento)
    close() {
      if (!this.dialog.open || this.dialog.classList.contains('is-closing')) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finish = () => {
        this.dialog.classList.remove('is-closing');
        this.dialog.close();
        // El estado del botón se actualiza aquí también (no depende solo del evento "close")
        this.toggle.setAttribute('aria-expanded', 'false');
        this.showMain();
      };
      if (reduce) {
        finish();
        return;
      }
      this.dialog.classList.add('is-closing');
      setTimeout(finish, 240);
    }
  }

  // Cabecera fija: alto en --header-height y sombra cuando está pegada arriba
  class StickyHeader extends HTMLElement {
    connectedCallback() {
      this.header = this.querySelector('.header');
      this.resizeObserver = new ResizeObserver(() => this.setHeight());
      this.resizeObserver.observe(this);
      this.setHeight();

      if (!this.hasAttribute('data-sticky')) return;
      this.onScroll = () => this.update();
      window.addEventListener('scroll', this.onScroll, { passive: true });
      this.update();
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
      if (this.onScroll) window.removeEventListener('scroll', this.onScroll);
      document.documentElement.style.removeProperty('--header-height');
    }

    setHeight() {
      const height = this.hasAttribute('data-sticky') ? this.offsetHeight : 0;
      document.documentElement.style.setProperty('--header-height', `${height}px`);
    }

    update() {
      const stuck = window.scrollY > 0 && this.getBoundingClientRect().top <= 0;
      this.header?.classList.toggle('header--stuck', stuck);
    }
  }

  // Imágenes del mega menú y del menú móvil: solo se descargan cuando se van a ver
  // (en el HTML llevan data-src / data-srcset en lugar de src / srcset)
  function loadDeferredImages(root) {
    root?.querySelectorAll('img[data-src]').forEach((img) => {
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      img.src = img.dataset.src;
      img.removeAttribute('data-src');
      img.removeAttribute('data-srcset');
    });
  }
  ['pointerenter', 'focusin'].forEach((type) => {
    document.addEventListener(
      type,
      (event) => {
        const nav = event.target.closest?.('.header__nav');
        if (nav) loadDeferredImages(nav);
      },
      true
    );
  });

  // Mega menú: Esc lo cierra (hasta que el ratón o el foco salgan de la categoría)
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const item = document.activeElement?.closest('[data-mega-item]');
    if (!item) return;
    item.classList.add('is-closed');
    item.querySelector('.nav-menu__link')?.focus();
  });
  document.addEventListener('pointerleave', (event) => {
    if (event.target.matches?.('[data-mega-item]')) event.target.classList.remove('is-closed');
  }, true);
  document.addEventListener('focusout', (event) => {
    const item = event.target.closest?.('[data-mega-item]');
    if (item && !item.contains(event.relatedTarget)) item.classList.remove('is-closed');
  });
  document.addEventListener('shopify:block:select', (event) => {
    if (event.target.matches('[data-mega-item]')) loadDeferredImages(event.target);
    if (event.target.matches('[data-mega-item]')) event.target.classList.add('is-open');
  });
  document.addEventListener('shopify:block:deselect', (event) => {
    if (event.target.matches('[data-mega-item]')) event.target.classList.remove('is-open');
  });

  if (!customElements.get('sticky-header')) {
    customElements.define('sticky-header', StickyHeader);
  }

  if (!customElements.get('header-drawer')) {
    customElements.define('header-drawer', HeaderDrawer);
  }

  // Buscador: texto distinto en desktop y móvil, y sugerencias a partir de 3 letras
  class HeaderSearch extends HTMLElement {
    connectedCallback() {
      this.input = this.querySelector('input[type="search"]');
      this.results = this.querySelector('[data-predictive-results]');
      this.live = this.querySelector('[data-predictive-live]');
      if (!this.input) return;

      const desktop = window.matchMedia('(min-width: 990px)');
      const update = () => {
        this.input.placeholder = desktop.matches
          ? this.input.dataset.placeholderDesktop
          : this.input.dataset.placeholderMobile;
      };
      update();
      desktop.addEventListener('change', update);

      if (!this.results || !this.dataset.suggestUrl) return;
      this.minChars = Number(this.dataset.minChars || 3);
      this.cache = new Map();

      this.input.addEventListener('input', () => this.onInput());
      this.input.addEventListener('focus', () => {
        if (this.term.length >= this.minChars && this.results.innerHTML.trim()) this.open();
      });
      this.input.addEventListener('keydown', (event) => this.onKeydown(event));
      this.addEventListener('focusout', () => {
        setTimeout(() => {
          if (!this.contains(document.activeElement)) this.close();
        });
      });
      document.addEventListener('click', (event) => {
        if (!this.contains(event.target)) this.close();
      });
    }

    get term() {
      return this.input.value.trim();
    }

    onInput() {
      clearTimeout(this.debounce);
      if (this.term.length < this.minChars) {
        this.controller?.abort();
        this.classList.remove('is-loading');
        // El contenido se vacía al terminar la animación de cierre
        this.close();
        return;
      }
      if (!this.cache.has(this.term.toLowerCase())) this.classList.add('is-loading');
      this.debounce = setTimeout(() => this.fetchResults(this.term), 150);
    }

    async fetchResults(term) {
      const key = term.toLowerCase();
      if (this.cache.has(key)) {
        this.classList.remove('is-loading');
        this.render(this.cache.get(key));
        return;
      }

      this.controller?.abort();
      const controller = (this.controller = new AbortController());
      this.results.setAttribute('aria-busy', 'true');

      const params = new URLSearchParams({
        q: term,
        'resources[type]': 'product,collection,query',
        'resources[limit]': '6',
        'resources[limit_scope]': 'each',
        'resources[options][unavailable_products]': 'last',
        section_id: 'predictive-search',
      });

      try {
        const response = await fetch(`${this.dataset.suggestUrl}?${params}`, { signal: controller.signal });
        if (!response.ok) throw new Error(response.statusText);
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const markup = html.querySelector('#PredictiveSearchResults')?.innerHTML || '';
        this.cache.set(key, markup);
        // Si mientras tanto se ha seguido escribiendo, se ignora esta respuesta
        if (this.term.toLowerCase() === key) this.render(markup);
      } catch (error) {
        if (error.name !== 'AbortError') this.close();
      } finally {
        // Una petición cancelada no quita el estado de carga de la siguiente
        if (this.controller === controller) {
          this.results.removeAttribute('aria-busy');
          this.classList.remove('is-loading');
        }
      }
    }

    render(markup) {
      this.results.innerHTML = markup;
      if (!markup.trim() || this.term.length < this.minChars) {
        this.close();
        return;
      }
      this.decorate();
      // Entrada en cascada solo al abrir; si ya estaba abierto, el contenido nuevo hace un fundido corto
      const opening = this.results.hidden || this.results.classList.contains('is-closing');
      this.results.classList.remove('is-entering', 'is-updating');
      void this.results.offsetWidth;
      this.results.classList.add(opening ? 'is-entering' : 'is-updating');
      this.open();
      const status = this.results.querySelector('[data-predictive-status]');
      if (this.live && status) this.live.textContent = status.textContent;
    }

    // Orden de entrada escalonada (--i) y resaltado del texto buscado en los nombres de producto
    decorate() {
      const items = this.results.querySelectorAll(
        '.predictive-search__heading, .predictive-search__pill, .predictive-search__product, .predictive-search__empty, .predictive-search__all'
      );
      items.forEach((item, index) => item.style.setProperty('--i', Math.min(index, 14)));

      const words = this.term
        .split(/\s+/)
        .filter((word) => word.length >= 2)
        .map((word) => word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      if (!words.length) return;
      const pattern = new RegExp(`(${words.join('|')})`, 'gi');

      this.results.querySelectorAll('.predictive-search__title').forEach((title) => {
        const parts = title.textContent.split(pattern);
        if (parts.length < 2) return;
        title.replaceChildren(
          ...parts.map((part, index) => {
            if (index % 2 === 0) return document.createTextNode(part);
            const mark = document.createElement('mark');
            mark.className = 'predictive-search__match';
            mark.textContent = part;
            return mark;
          })
        );
      });
    }

    get options() {
      return [...this.results.querySelectorAll('[role="option"]')];
    }

    onKeydown(event) {
      if (event.key === 'Escape') {
        if (!this.results.hidden) {
          event.preventDefault();
          this.close();
        }
        return;
      }
      if (this.results.hidden) return;

      const options = this.options;
      const current = options.findIndex((option) => option.getAttribute('aria-selected') === 'true');

      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        if (!options.length) return;
        const step = event.key === 'ArrowDown' ? 1 : -1;
        const next = current === -1 ? (step === 1 ? 0 : options.length - 1) : (current + step + options.length) % options.length;
        this.select(options[next]);
      } else if (event.key === 'Enter' && current !== -1) {
        event.preventDefault();
        window.location.href = options[current].href;
      }
    }

    select(option) {
      this.options.forEach((item) => item.setAttribute('aria-selected', String(item === option)));
      this.input.setAttribute('aria-activedescendant', option.id);
      option.scrollIntoView({ block: 'nearest' });
    }

    open() {
      clearTimeout(this.closeTimer);
      this.results.classList.remove('is-closing');
      this.results.hidden = false;
      this.input.setAttribute('aria-expanded', 'true');
    }

    // Cierre animado (con "reducir movimiento", al momento)
    close() {
      if (!this.results) return;
      this.input.setAttribute('aria-expanded', 'false');
      this.input.removeAttribute('aria-activedescendant');
      this.options.forEach((item) => item.setAttribute('aria-selected', 'false'));

      const finish = () => {
        this.results.classList.remove('is-closing', 'is-entering', 'is-updating');
        this.results.hidden = true;
        if (this.term.length < this.minChars) this.results.innerHTML = '';
      };
      clearTimeout(this.closeTimer);
      if (this.results.hidden || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        finish();
        return;
      }
      this.results.classList.add('is-closing');
      this.closeTimer = setTimeout(finish, 150);
    }
  }

  if (!customElements.get('header-search')) {
    customElements.define('header-search', HeaderSearch);
  }
{% endjavascript %}

