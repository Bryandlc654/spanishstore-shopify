{% comment %}
  Barra de ventajas (envío, frío, origen, pago seguro).
  Cada ventaja es un bloque con icono (de la lista o una imagen propia), título y descripción.
  - Desktop: una fila centrada (hasta 4 columnas), alineadas verticalmente al centro.
  - Móvil: carrusel deslizable con 2 ventajas a la vista y puntos debajo (uno por posición:
    nº de ventajas − 1). Diseño a 347 px: icono rojo, título de 17 px, texto de 12,5 px, puntos de 9 px.
  - Opcional: patrón decorativo de fondo (pattern-tile.svg) y ancho "wide" (todo el contenedor),
    p. ej. en la ficha de producto, donde se une con la sección "Information".
  - Opcional: título y subtítulo centrados encima (p. ej. "How we choose our products" en Sobre nosotros).
{% endcomment %}

{%- liquid
  if section.settings.show_pattern
    assign pattern_url = 'pattern-tile.svg' | asset_url
  endif
-%}

{%- if section.blocks.size > 0 -%}
  <div
    class="features full-width features--{{ section.settings.width }}"
    style="--features-bg: {{ section.settings.background }}; --features-icon: {{ section.settings.icon_color }}; --features-columns: {{ section.blocks.size | at_most: 4 }};{% if pattern_url %} --features-pattern: url('{{ pattern_url }}');{% endif %}"
  >
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="features__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="features__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="features__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <features-carousel>
    <ul class="features__list" role="list" data-features-track>
      {%- for block in section.blocks -%}
        <li class="features__item" {{ block.shopify_attributes }}>
          {%- if block.settings.custom_icon != blank -%}
            <span class="features__icon">
              {{
                block.settings.custom_icon
                | image_url: width: 96
                | image_tag: alt: '', loading: 'lazy', width: 24, height: 24
              }}
            </span>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="features__icon">
              {{- block.settings.icon | prepend: 'icon-' | append: '.svg' | inline_asset_content -}}
            </span>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <p class="features__title">{{ block.settings.title | escape }}</p>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="features__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.blocks.size > 2 -%}
      <div class="features__dots" data-features-dots>
        {%- assign dot_count = section.blocks.size | minus: 1 -%}
        {%- for i in (1..dot_count) -%}
          <button
            type="button"
            class="features__dot"
            aria-label="{{ 'sections.features.go_to' | t: number: forloop.index, count: dot_count }}"
            {% if forloop.first %}
              aria-current="true"
            {% endif %}
            data-index="{{ forloop.index0 }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    </features-carousel>
  </div>
{%- endif -%}

{% stylesheet %}
  .features {
    background-color: var(--features-bg);
    background-image: var(--features-pattern, none);
    background-size: 3.875rem;
  }

  .features__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 1.75rem 1rem;
    width: min(66.75rem, 100% - var(--page-margin) * 2);
    margin-inline: auto;
    padding: 2rem 0;
    list-style: none;
  }

  .features__header {
    width: min(40rem, 100% - var(--page-margin) * 2);
    margin-inline: auto;
    padding-block-start: 2.5rem;
    text-align: center;
  }

  .features__heading {
    margin: 0;
    color: #000;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .features__subheading {
    margin: 0.5rem 0 0;
    color: #313131;
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.5;
  }

  .features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .features__icon {
    display: flex;
    margin-block-end: 0.5rem;
    color: var(--features-icon);
  }

  .features__icon svg,
  .features__icon img {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
  }

  /* Rellena el interior de las ruedas del camión con el color de fondo */
  .features__icon .icon-knockout {
    fill: var(--features-bg);
  }

  .features__title {
    margin: 0;
    color: #000;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .features__text {
    max-width: 8.5rem;
    margin-block-start: 0.375rem;
    color: #5f5c55;
    font-size: 0.9375rem;
    line-height: 1.25;
  }

  .features__text p {
    margin: 0;
  }

  features-carousel {
    display: block;
  }

  .features__dots {
    display: none;
  }

  /* Móvil: carrusel (2 a la vista, se desliza de una en una) */
  @media (max-width: 749px) {
    .features__list {
      display: flex;
      gap: 0;
      width: 100%;
      padding: 1.5rem 0 0;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .features__list::-webkit-scrollbar {
      display: none;
    }

    .features__item {
      flex: 0 0 50%;
      align-self: flex-start;
      padding-inline: 0.5rem;
      scroll-snap-align: start;
    }

    .features__icon {
      margin-block-end: 0.3125rem;
    }

    .features__icon svg,
    .features__icon img {
      width: 2rem;
      height: 2rem;
    }

    .features__title {
      font-size: 1.0625rem;
      line-height: 1.25;
    }

    .features__text {
      max-width: 10rem;
      margin-block-start: 0.625rem;
      font-size: 0.9375rem;
      line-height: 0.875rem;
    }

    .features__dots {
      display: flex;
      justify-content: center;
      gap: 0.375rem;
      padding-block: 1.6875rem;
    }

    /* Sin puntos (2 ventajas o menos): el mismo aire abajo */
    .features__list:last-child {
      padding-block-end: 1.75rem;
    }

    .features__dot {
      position: relative;
      width: 0.5625rem;
      height: 0.5625rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background-color: #e9e8e5;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    /* Zona táctil más grande que el punto */
    .features__dot::before {
      content: '';
      position: absolute;
      inset: -0.5rem -0.1875rem;
    }

    .features__dot[aria-current='true'] {
      background-color: var(--color-accent);
    }
  }

  @media (min-width: 750px) {
    .features__header {
      padding-block-start: 3.5rem;
    }

    .features__heading {
      font-size: 1.4375rem;
    }

    .features--wide .features__list {
      width: min(75rem, 100% - var(--page-margin) * 2);
    }

    .features__list {
      grid-template-columns: repeat(var(--features-columns), minmax(0, 1fr));
      column-gap: 0;
      min-height: 9.875rem;
      padding-block: 2rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Móvil: marca el punto de la posición actual y permite ir a una ventaja tocando su punto
  class FeaturesCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-features-track]');
      this.dots = [...this.querySelectorAll('.features__dot')];
      if (!this.track || !this.dots.length) return;

      this.dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const item = this.track.children[Number(dot.dataset.index)];
          if (item) this.track.scrollTo({ left: item.offsetLeft - this.track.offsetLeft, behavior: 'smooth' });
        });
      });
      this.track.addEventListener('scroll', () => this.update(), { passive: true });
      this.update();
    }

    update() {
      const item = this.track.children[0];
      if (!item) return;
      const max = this.track.scrollWidth - this.track.clientWidth;
      let index = Math.round(this.track.scrollLeft / item.offsetWidth);
      if (this.track.scrollLeft >= max - 2) index = this.dots.length - 1;
      index = Math.min(index, this.dots.length - 1);
      this.dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    }
  }

  if (!customElements.get('features-carousel')) {
    customElements.define('features-carousel', FeaturesCarousel);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.features_bar",
  "tag": "section",
  "class": "features-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:labels.background",
      "default": "#FAF8F1"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:labels.icon_color",
      "default": "#BE1621"
    },
    {
      "type": "checkbox",
      "id": "show_pattern",
      "label": "t:labels.show_pattern",
      "default": false
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.hero_layout",
      "options": [
        { "value": "narrow", "label": "t:options.features_width.narrow" },
        { "value": "wide", "label": "t:options.features_width.wide" }
      ],
      "default": "narrow"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:general.feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "none", "label": "t:options.icon.none" },
            { "value": "truck", "label": "t:options.icon.truck" },
            { "value": "snowflake", "label": "t:options.icon.snowflake" },
            { "value": "globe", "label": "t:options.icon.globe" },
            { "value": "lock", "label": "t:options.icon.lock" },
            { "value": "award", "label": "t:options.icon.award" },
            { "value": "leaf", "label": "t:options.icon.leaf" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "t:labels.custom_icon",
          "info": "t:info.custom_icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Free shipping"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>Across Canada on orders over CAD $300</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.features_bar",
      "blocks": [
        { "type": "feature" },
        { "type": "feature", "settings": { "icon": "snowflake", "title": "Carefully chilled", "text": "<p>Thermal packaging for sensitive products</p>" } },
        { "type": "feature", "settings": { "icon": "globe", "title": "From Spain", "text": "<p>Authentic Spanish products</p>" } },
        { "type": "feature", "settings": { "icon": "lock", "title": "Secure payment", "text": "<p>Different payment methods</p>" } }
      ]
    }
  ]
}
{% endschema %}
